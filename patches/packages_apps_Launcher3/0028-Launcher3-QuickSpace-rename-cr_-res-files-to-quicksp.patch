     <item type="id" name="search_container_hotseat" />
+    <!-- QuickSpace pinned container on first workspace screen -->
+    <item type="id" name="reserved_container_workspace" />
 
     <!-- View ID to use for QSB widget -->
     <item type="id" name="qsb_widget" />
diff --git a/res/values/cr_arrays.xml b/res/values/quickspace_arrays.xml
similarity index 100%
rename from res/values/cr_arrays.xml
rename to res/values/quickspace_arrays.xml
diff --git a/res/values/cr_strings.xml b/res/values/quickspace_strings.xml
similarity index 100%
