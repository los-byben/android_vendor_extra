-
-    <!-- Quickspace -->
-    <item type="id" name="reserved_container_workspace" />
-</resources>
diff --git a/res/values/id.xml b/res/values/id.xml
index 96a2eb11ac..1e44940c4f 100644
--- a/res/values/id.xml
+++ b/res/values/id.xml
@@ -48,6 +48,8 @@
     <item type="id" name="search_container_workspace" />
