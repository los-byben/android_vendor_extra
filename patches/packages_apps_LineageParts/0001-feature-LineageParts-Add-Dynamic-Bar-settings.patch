diff --git a/src/org/lineageos/lineageparts/statusbar/DynamicBarSettings.java b/src/org/lineageos/lineageparts/statusbar/DynamicBarSettings.java
new file mode 100644
index 0000000..21efb2d
--- /dev/null
+++ b/src/org/lineageos/lineageparts/statusbar/DynamicBarSettings.java
@@ -0,0 +1,203 @@
+/*
+ * SPDX-FileCopyrightText: The crDroid Android Project
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.lineageparts.statusbar;
+
+import android.content.ContentResolver;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import org.json.JSONArray;
+
+import org.lineageos.lineageparts.R;
+import org.lineageos.lineageparts.SettingsPreferenceFragment;
+
+/**
+ * Settings screen for the Dynamic Bar status bar chips.
+ *
+ * <p>Adapted from crDroidSettings. All values live in {@link Settings.Secure} so SystemUI can read
+ * them without depending on LineageParts.
+ */
+public class DynamicBarSettings extends SettingsPreferenceFragment {
+
+    private static final String KEY_ENABLED = "ax_dynamic_bar_enabled";
+    private static final String KEY_KEYGUARD_ENABLED = "ax_dynamic_bar_keyguard_enabled";
+    private static final String KEY_EVENTS = "ax_dynamic_bar_events";
+    private static final String KEY_COMPACT_NOTIFICATIONS = "ax_dynamic_bar_compact_notifications";
+    private static final String KEY_BATTERY_CHIP_MODE =
+            "ax_dynamic_bar_keyguard_battery_chip_mode";
+
+    /** Event ids understood by the SystemUI side (see IslandActions.EVENT_TYPE_IDS). */
+    private static final String[] EVENT_TYPE_IDS = {
+            "audio_recording", "media", "call", "notification",
+            "timer", "stopwatch", "alarm", "charging",
+            "bluetooth", "hotspot", "ringer", "vpn",
+            "clipboard", "torch", "promoted_ongoing", "sports",
+            "app_switch", "biometric_unlock",
+    };
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+
+    private ContentResolver mResolver;
+    private ContentObserver mSettingsObserver;
+    private ListPreference mBatteryChipMode;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.dynamic_bar_settings);
+        getActivity().setTitle(R.string.dynamic_bar);
+
+        mResolver = getActivity().getContentResolver();
+
+        setupBatteryChipMode();
+        setupKeyguardSubPrefs();
+        setupEventToggles();
+        updateCompactNotificationVisibility();
+        registerObserver();
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        if (mSettingsObserver != null) {
+            mResolver.unregisterContentObserver(mSettingsObserver);
+        }
+    }
+
+    private void setupBatteryChipMode() {
+        mBatteryChipMode = findPreference(KEY_BATTERY_CHIP_MODE);
+        if (mBatteryChipMode == null) {
+            return;
+        }
+        int mode = Settings.Secure.getIntForUser(mResolver, KEY_BATTERY_CHIP_MODE, 1,
+                UserHandle.USER_CURRENT);
+        mBatteryChipMode.setValue(String.valueOf(mode));
+        mBatteryChipMode.setOnPreferenceChangeListener((preference, newValue) -> {
+            Settings.Secure.putIntForUser(mResolver, KEY_BATTERY_CHIP_MODE,
+                    Integer.parseInt((String) newValue), UserHandle.USER_CURRENT);
+            return true;
+        });
+    }
+
+    private void setupKeyguardSubPrefs() {
+        Preference keyguardPref = findPreference(KEY_KEYGUARD_ENABLED);
+        if (keyguardPref != null) {
+            keyguardPref.setOnPreferenceChangeListener((preference, newValue) -> {
+                updateKeyguardSubPrefsVisibility((Boolean) newValue);
+                return true;
+            });
+        }
+        boolean keyguardEnabled = Settings.Secure.getIntForUser(mResolver,
+                KEY_KEYGUARD_ENABLED, 1, UserHandle.USER_CURRENT) == 1;
+        updateKeyguardSubPrefsVisibility(keyguardEnabled);
+    }
+
+    private void updateKeyguardSubPrefsVisibility(boolean keyguardEnabled) {
+        Preference batteryPref = findPreference(KEY_BATTERY_CHIP_MODE);
+        if (batteryPref != null) {
+            batteryPref.setVisible(keyguardEnabled);
+        }
+    }
+
+    private void setupEventToggles() {
+        java.util.Set<String> disabledEvents = getDisabledEvents();
+        for (String typeId : EVENT_TYPE_IDS) {
+            SwitchPreferenceCompat pref = findPreference("event_" + typeId);
+            if (pref == null) {
+                continue;
+            }
+            pref.setChecked(!disabledEvents.contains(typeId));
+            pref.setOnPreferenceChangeListener((preference, newValue) -> {
+                toggleEvent(typeId, (Boolean) newValue);
+                if ("notification".equals(typeId)) {
+                    updateCompactNotificationVisibility();
+                }
+                return true;
+            });
+        }
+    }
+
+    private java.util.Set<String> getDisabledEvents() {
+        String json = Settings.Secure.getStringForUser(mResolver, KEY_EVENTS,
+                UserHandle.USER_CURRENT);
+        if (json == null || json.trim().isEmpty()) {
+            return java.util.Collections.emptySet();
+        }
+        try {
+            JSONArray arr = new JSONArray(json);
+            java.util.Set<String> result = new java.util.HashSet<>();
+            for (int i = 0; i < arr.length(); i++) {
+                result.add(arr.getString(i));
+            }
+            return result;
+        } catch (Exception e) {
+            return java.util.Collections.emptySet();
+        }
+    }
+
+    private void toggleEvent(String typeId, boolean enabled) {
+        java.util.Set<String> current = getDisabledEvents();
+        java.util.Set<String> updated = new java.util.HashSet<>(current);
+        if (enabled) {
+            updated.remove(typeId);
+        } else {
+            updated.add(typeId);
+        }
+        String json = updated.isEmpty() ? "" : new JSONArray(updated).toString();
+        Settings.Secure.putStringForUser(mResolver, KEY_EVENTS, json, UserHandle.USER_CURRENT);
+    }
+
+    private void updateCompactNotificationVisibility() {
+        Preference compactPref = findPreference(KEY_COMPACT_NOTIFICATIONS);
+        SwitchPreferenceCompat notifPref = findPreference("event_notification");
+        if (compactPref != null && notifPref != null) {
+            compactPref.setVisible(notifPref.isChecked());
+        }
+    }
+
+    private void registerObserver() {
+        mSettingsObserver = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange, Uri uri) {
+                String key = uri == null ? null : uri.getLastPathSegment();
+                if (KEY_EVENTS.equals(key)) {
+                    java.util.Set<String> disabledEvents = getDisabledEvents();
+                    for (String typeId : EVENT_TYPE_IDS) {
+                        SwitchPreferenceCompat pref = findPreference("event_" + typeId);
+                        if (pref != null) {
+                            pref.setChecked(!disabledEvents.contains(typeId));
+                        }
+                    }
+                    updateCompactNotificationVisibility();
+                } else if (KEY_KEYGUARD_ENABLED.equals(key)) {
+                    boolean enabled = Settings.Secure.getIntForUser(mResolver,
+                            KEY_KEYGUARD_ENABLED, 1, UserHandle.USER_CURRENT) == 1;
+                    updateKeyguardSubPrefsVisibility(enabled);
+                } else if (KEY_BATTERY_CHIP_MODE.equals(key)) {
+                    int mode = Settings.Secure.getIntForUser(mResolver, KEY_BATTERY_CHIP_MODE,
+                            1, UserHandle.USER_CURRENT);
+                    if (mBatteryChipMode != null) {
+                        mBatteryChipMode.setValue(String.valueOf(mode));
+                    }
+                }
+            }
+        };
+        for (String key : new String[] { KEY_EVENTS, KEY_KEYGUARD_ENABLED, KEY_BATTERY_CHIP_MODE }) {
+            mResolver.registerContentObserver(Settings.Secure.getUriFor(key), false,
+                    mSettingsObserver, UserHandle.USER_ALL);
+        }
+    }
+}
