From aff2585413d7349e024adb1437557c3fa8d993e8 Mon Sep 17 00:00:00 2001
From: Byben <heybyben@gmail.com>
Date: Wed, 5 Aug 2026 10:02:01 +0700
Subject: [PATCH] config: Guard non-GMS configuration with WITH_GMS

Change-Id: I7f023e366d5104f96ada69b1868fc218b1801b3d
---
 config/common.mk        | 2 ++
 config/common_mobile.mk | 2 ++
 config/telephony.mk     | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/config/common.mk b/config/common.mk
index 3b68625..5678e76 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -268,10 +268,12 @@ endif
 # Audio files
 $(call inherit-product, vendor/lineage/audio/audio.mk)
 
+ifeq ($(WITH_GMS),false)
 # SetupWizard
 PRODUCT_PRODUCT_PROPERTIES += \
     setupwizard.theme=glif_v4 \
     setupwizard.feature.day_night_mode_enabled=true
+endif
 
 PRODUCT_ENFORCE_RRO_EXCLUDED_OVERLAYS += vendor/lineage/overlay/no-rro
 PRODUCT_PACKAGE_OVERLAYS += \
diff --git a/config/common_mobile.mk b/config/common_mobile.mk
index 38003df..00bec05 100644
--- a/config/common_mobile.mk
+++ b/config/common_mobile.mk
@@ -8,10 +8,12 @@ include vendor/lineage/config/aosp_audio.mk
 # Include Lineage audio files
 include vendor/lineage/config/lineage_audio.mk
 
+ifeq ($(WITH_GMS),false)
 # Default notification/alarm sounds
 PRODUCT_PRODUCT_PROPERTIES += \
     ro.config.notification_sound=Argon.ogg \
     ro.config.alarm_alert=Hassium.ogg
+endif
 
 # Apps
 PRODUCT_PACKAGES += \
diff --git a/config/telephony.mk b/config/telephony.mk
index 6881846..60cbdf7 100644
--- a/config/telephony.mk
+++ b/config/telephony.mk
@@ -16,9 +16,11 @@ PRODUCT_PACKAGES += \
     messaging \
     Stk
 
+ifeq ($(WITH_GMS),false)
 # Default ringtone
 PRODUCT_PRODUCT_PROPERTIES += \
     ro.config.ringtone=Orion.ogg
+endif
 
 # Tethering - allow without requiring a provisioning app
 # (for devices that check this)
-- 
2.54.0

