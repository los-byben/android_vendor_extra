From 09dc3da4764e4b017356d0d5f663824493c26c24 Mon Sep 17 00:00:00 2001
From: kleidione Freitas <kleidione@gmail.com>
Date: Sat, 25 Jul 2026 09:49:08 -0300
Subject: [PATCH] vibrator: Enforce minimum timeout for LDO vibrator motor

ERM/LDO vibrator motors need a minimum energization time to
overcome mechanical inertia and produce perceptible vibration.
Short pulses (~10-20ms), such as those generated by the framework's
fallback for prebaked effects (TICK, CLICK, etc. used by keyboard
and touch haptic feedback), were too short for the motor to spin up,
resulting in "silent" vibration calls that completed successfully
but produced no physical feedback.

Enforce a 40ms floor on timeoutMs specifically for the LED-class
(ledVib) path, leaving the force-feedback (ff) path untouched.

Fixes: keyboard/touch haptic feedback not vibrating on qpnp-vibrator-ldo

Change-Id: I8aa14c6217a56cc6c5a992601198d67b78b84fb6
Signed-off-by: kleidione <kleidione@gmail.com>
---
 aidl/VibratorOL/Vibrator.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/aidl/VibratorOL/Vibrator.cpp b/aidl/VibratorOL/Vibrator.cpp
index 1592922..eabb4a2 100644
--- a/aidl/VibratorOL/Vibrator.cpp
+++ b/aidl/VibratorOL/Vibrator.cpp
@@ -610,6 +610,17 @@ ndk::ScopedAStatus VibratorOL::on(int32_t timeoutMs,
                                 const std::shared_ptr<IVibratorCallback>& callback) {
     int ret;
 
+    if (ledVib.mDetected) {
+        // ERM/LDO motors need a minimum energization time to overcome
+        // mechanical inertia and produce perceptible vibration. Short pulses
+        // (fallback for prebaked effects like TICK/CLICK, typically 10-20ms)
+        // result in "silent" vibration without this floor.
+        const int32_t kMinLdoTimeoutMs = 60;
+        if (timeoutMs < kMinLdoTimeoutMs) {
+            timeoutMs = kMinLdoTimeoutMs;
+        }
+    }
+
     ALOGD("Vibrator on for timeoutMs: %d", timeoutMs);
     if (ledVib.mDetected)
         ret = ledVib.on(timeoutMs);
