                 sCertifiedProps = Arrays.asList(context.getResources().getStringArray(R.array.config_certifiedBuildProperties));
             }
         }
 
+        if (sCertifiedProps.isEmpty()) {
+            dlog("Certified props are not set");
+            return;
+        }
+
