+@Composable
+private fun NotificationReplyField(
+    reply: IslandEvent.ReplyAction,
+    sbn: StatusBarNotification,
+    interactor: IslandActions,
+    eventId: String,
+) {
+    var replyText by remember { mutableStateOf("") }
+    val lastFocused = remember { booleanArrayOf(false) }
+    var fieldFocused by remember { mutableStateOf(false) }
+    val windowInfo = LocalWindowInfo.current
+    val keyboard = LocalSoftwareKeyboardController.current
+    val focusManager = LocalFocusManager.current
+
+    LaunchedEffect(fieldFocused) {
+        if (!fieldFocused) return@LaunchedEffect
+        withTimeoutOrNull(REPLY_WINDOW_FOCUS_TIMEOUT_MS) {
+            snapshotFlow { windowInfo.isWindowFocused }.first { it }
+        } ?: return@LaunchedEffect
+        keyboard?.show()
+    }
+
+    Row(
+        modifier =
+            Modifier.fillMaxWidth()
+                .height(40.dp)
+                .clip(ShapeChip)
+                .background(DarkCard.copy(alpha = AlphaGlass)),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        BasicTextField(
+            value = replyText,
+            onValueChange = { replyText = it },
+            modifier =
+                Modifier.weight(1f).padding(horizontal = SpaceLg).onFocusChanged { focusState ->
+                    if (focusState.isFocused == lastFocused[0]) return@onFocusChanged
+                    lastFocused[0] = focusState.isFocused
+                    fieldFocused = focusState.isFocused
+                    interactor.onFocusableRequested?.invoke(focusState.isFocused)
+                    if (focusState.isFocused) {
+                        interactor.onNotificationInteraction(eventId)
+                    }
+                },
+            textStyle = MaterialTheme.typography.bodySmall.copy(color = OnCardText),
+            singleLine = true,
+            cursorBrush = SolidColor(IslandTone.ACCENT.tint),
+            decorationBox = { inner ->
+                if (replyText.isEmpty()) {
+                    Text(reply.label.toString(), color = SubtleGray, style = MaterialTheme.typography.bodySmall)
+                }
+                inner()
+            },
+        )
+        if (replyText.isNotEmpty()) {
+            val context = LocalContext.current
+            Icon(
+                Icons.AutoMirrored.Filled.Send,
+                contentDescription = reply.label.toString(),
+                tint = IslandTone.ACCENT.tint,
+                modifier =
+                    Modifier.size(32.dp)
+                        .clip(CircleShape)
+                        .clickable {
+                            sendReply(context, reply, replyText, sbn)
+                            replyText = ""
+                            focusManager.clearFocus()
+                            interactor.onFocusableRequested?.invoke(false)
+                        }
+                        .padding(SpaceSm),
+            )
+        }
+    }
+}
+
+private fun sendReply(
+    context: Context,
+    reply: IslandEvent.ReplyAction,
+    text: String,
+    sbn: StatusBarNotification,
+) {
+    val intent =
+        Intent().apply {
+            val results = Bundle().apply { putCharSequence(reply.remoteInput.resultKey, text) }
+            RemoteInput.addResultsToIntent(arrayOf(reply.remoteInput), this, results)
+        }
+    try {
+        reply.action.actionIntent?.sendWithBal(context, intent)
+    } catch (e: Exception) {
+        Log.w("NotificationReply", "Failed to send reply", e)
+    }
+}
