+                    onDismiss = onDismiss,
+                    onReplyClick = onShowReply,
+                )
+            }
+        }
+
+        if (showReply && notification.replyAction != null) {
+            ReplyField(
+                reply = notification.replyAction!!,
+                accent = accent,
+                interactor = interactor,
+                onSent = onSentReply,
+                onFocusChange = onReplyFocusChange,
+            )
