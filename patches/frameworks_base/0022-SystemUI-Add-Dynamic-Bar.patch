+                            scaleIn(initialScale = 0.85f, animationSpec = motionScheme.defaultSpatialSpec())) togetherWith
+                            (fadeOut(motionScheme.fastEffectsSpec()) +
+                                scaleOut(targetScale = 0.85f, animationSpec = motionScheme.fastSpatialSpec())) using
