+        private const val MAX_CLIPBOARD_IMAGE_WIDTH_PX = 512
+        private const val MAX_CLIPBOARD_IMAGE_HEIGHT_PX = 2048
+        private const val CLIPBOARD_IMAGE_TIMEOUT_MS = 2_000L
+
