+                            it == DeskClockActions.PAUSE_STOPWATCH ||
+                            it == DeskClockActions.RESET_STOPWATCH ||
+                            it == DeskClockActions.LAP_STOPWATCH ||
+                            it == DeskClockActions.SHOW_STOPWATCH
